<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable></PropertyGroup>
 <PropertyGroup><GameDir Condition="'$(GameDir)' == ''">$(ROGUE_GAME_DIR)</GameDir></PropertyGroup>
 <ItemGroup>
  <Compile Include="../../src/RoguePrince.CheatMenu/Core/*.cs" Link="Production/%(Filename)%(Extension)" />
  <Compile Include="../../src/RoguePrince.CheatMenu/ToolLimitActions.cs" Link="Production/ToolLimitActions.cs" />
  <Reference Include="0Harmony"><HintPath>$(GameDir)/BepInEx/core/0Harmony.dll</HintPath></Reference>
 </ItemGroup>
 <Target Name="CheckHarmonyReference" BeforeTargets="ResolveReferences">
  <Error Condition="!Exists('$(GameDir)/BepInEx/core/0Harmony.dll')" Text="Set GameDir or ROGUE_GAME_DIR to your initialized BepInEx game directory." />
 </Target>
</Project>
